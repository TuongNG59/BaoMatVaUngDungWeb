__pycache__/
*.pyc
*.pyo
*.pyd

# File cấu hình của trình soạn thảo (VS Code, PyCharm)
.vscode/
.idea/

# Các file lưu trữ khóa bí mật / tạm thời
*.pem
*.p12
*.pfx