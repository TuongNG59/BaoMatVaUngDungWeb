# Giữ lại cấu trúc thư mục
!*/

# Chỉ cho phép theo dõi các file .py
!*.py

*.pdf

# Giữ lại chính file .gitignore
!.gitignore

# Môi trường ảo Python
venv/
.venv/
env/
ENV/

