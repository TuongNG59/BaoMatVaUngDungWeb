# 1. Môi trường ảo Python (QUAN TRỌNG NHẤT - Chặn toàn bộ thư viện)
venv/
.venv/
env/
ENV/

# 2. Các file cache biên dịch tự động của Python
__pycache__/
*.pyc
*.pyo
*.pyd

# 3. File cấu hình của trình soạn thảo (VS Code, PyCharm)
.vscode/
.idea/

# 4. Các file chứa khóa bí mật (Không push private key lên GitHub)
*.pem
*.p12
*.pfx
